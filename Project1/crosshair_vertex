#version 330 core

// Screen-space cross-hair. It needs no vertex buffer at all: the four corners
// of a quad are generated from gl_VertexID, so the CPU only issues one
// glDrawArrays(GL_TRIANGLE_STRIP, 0, 4) per frame.

uniform float uAspect;    // framebuffer width / height
uniform float uHalfSize;  // half of the quad, in NDC units (y axis)

out vec2 vUV;             // -1..1 across the quad

void main()
{
    int i = gl_VertexID % 4;
    vec2 c;
    if (i == 0)      c = vec2(-1.0, -1.0);
    else if (i == 1) c = vec2( 1.0, -1.0);
    else if (i == 2) c = vec2(-1.0,  1.0);
    else             c = vec2( 1.0,  1.0);

    vUV = c;
    // x is divided by the aspect ratio: uHalfSize is measured in y pixels,
    // and a pixel is "wider" in NDC on the x axis of a landscape window.
    gl_Position = vec4(c.x * uHalfSize / uAspect, c.y * uHalfSize, 0.0, 1.0);
}
