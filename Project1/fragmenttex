#version 330 core
out vec4 FragColor;

in vec3 Normal;
in vec3 FragPos;

uniform vec3 viewPos;

struct Material {
    vec3 ambient;
    vec3 diffuse;
    vec3 specular;
    float shininess;
};

struct Light {
    // direction the light TRAVELS (from the light towards the scene),
    // e.g. vec3(-0.2, -1.0, -0.3) for a sun high above pointing down.
    vec3 direction;

    vec3 ambient;
    vec3 diffuse;
    vec3 specular;
};

uniform Light light;
uniform Material material;

void main()
{
    // ambient
    vec3 ambient = light.ambient * material.ambient;

    // diffuse - a directional light has no position, only a direction, so
    // lightDir is the same for every fragment of every object
    vec3 norm = normalize(Normal);
    vec3 lightDir = normalize(-light.direction); // negate: from surface towards the light
    float diff = max(dot(norm, lightDir), 0.0);
    vec3 diffuse = light.diffuse * diff * material.diffuse;

    // specular
    vec3 viewDir = normalize(viewPos - FragPos);
    vec3 reflectDir = reflect(-lightDir, norm);
    float spec = pow(max(dot(viewDir, reflectDir), 0.0), material.shininess);
    vec3 specular = light.specular * spec * material.specular;

    vec3 result = ambient + diffuse + specular;
    FragColor = vec4(result, 1.0);
}
